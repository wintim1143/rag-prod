# rag-prod 环境变量模板。复制为 .env 后填写，.env 不提交。

# ===== chat / embedding 云 API（OpenAI 兼容，支持 DeepSeek 等）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 向量化方式：local = 本地 Transformers.js（默认，首次自动下载 all-MiniLM-L6-v2，
#            之后本地缓存，不依赖云 key）
#          cloud = 云 OpenAI 兼容 API（此时下面三项必须一起显式设置，
#           不能只设其中一两个，否则专用密钥/模型名会错配 LLM 的 baseUrl）
EMBEDDING_MODE=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 本地 embedding 模型下载源（可选）：默认 huggingface.co；网络受限时用镜像
# 例如 HF_ENDPOINT=https://hf-mirror.com（模型下载一次后本地缓存，之后离线可用）
HF_ENDPOINT=

# LanceDB 落盘目录（相对项目根）
LANCE_DB_PATH=./data/lance

# /ingest 允许读取的根目录（可选；设置后仅允许该目录内的路径）
INGEST_ROOT=

# 本地 cross-encoder 重排器模型 id（Transformers.js 可用版；
# 注意：BAAI/bge-reranker-* 的 Transformers.js 版 tokenizer 有兼容 bug，勿用）
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# HTTP 服务
PORT=3000
NODE_ENV=development

# 摄入切分（02 已生效）
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 检索参数（03 已生效）
RETRIEVAL_N=50
RETRIEVAL_K=5

# ---- 以下由后续切片（08）消费，尚不生效 ----
# HYBRID=true   # 03 已固定开启混合检索（向量 + BM25 + RRF）
# QUERY_REWRITE=false
# MULTI_QUERY=false
# HYDE=false
