# rag-prod 环境变量模板。复制为 .env 后填写，.env 不提交。

# ===== chat / embedding 云 API（OpenAI 兼容，支持 DeepSeek 等）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# Embedding 缺省回落到对应的 LLM_*（即同 provider）。
# 需要独立 embedding provider 时，下面三项必须一起显式设置
# （不能只设其中一两个，否则专用密钥/模型名会错配 LLM 的 baseUrl）。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# LanceDB 落盘目录（相对项目根）
LANCE_DB_PATH=./data/lance

# /ingest 允许读取的根目录（可选；设置后仅允许该目录内的路径）
INGEST_ROOT=

# 本地 cross-encoder 重排器模型 id（03 号切片实现时到 HF 核验）
RERANKER_MODEL=BAAI/bge-reranker-base

# HTTP 服务
PORT=3000
NODE_ENV=development

# 摄入切分（02 已生效）
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- 以下由后续切片（03/08）消费，尚不生效 ----
# RETRIEVAL_N=50
# RETRIEVAL_K=5
# HYBRID=true
# QUERY_REWRITE=false
# MULTI_QUERY=false
# HYDE=false
