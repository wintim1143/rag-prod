# rag-prod 环境变量模板。复制为 .env 后填写，.env 不提交。

# ===== chat / embedding 云 API（OpenAI 兼容，支持 DeepSeek 等）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# Embedding 缺省回落到对应的 LLM_*（即同 provider）。
# 需要独立 embedding provider 时，显式设置下面三项。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# LanceDB 落盘目录（相对项目根）
LANCE_DB_PATH=./data/lance

# 本地 cross-encoder 重排器模型 id（03 号切片实现时到 HF 核验）
RERANKER_MODEL=BAAI/bge-reranker-base

# HTTP 服务
PORT=3000
NODE_ENV=development

# ---- 以下由后续切片（02/03/08）消费，01 尚不生效 ----
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# RETRIEVAL_N=50
# RETRIEVAL_K=5
# HYBRID=true
# QUERY_REWRITE=false
# MULTI_QUERY=false
# HYDE=false
